# Salin file ini menjadi .env.local dan isi dengan nilai dari dashboard Supabase kamu
# Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-key-di-sini

# Ganti dengan domain website kamu setelah deploy (dipakai untuk sitemap & metadata)
NEXT_PUBLIC_SITE_URL=https://namadomainkamu.com
